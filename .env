# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=srm-tech.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=https://demoapp.srm-tech.com

# Environment: local, staging, production
ENVIRONMENT=production

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="https://demoapp.srm-tech.com,https://demoapi.srm-tech.com"
SECRET_KEY=changethissecurelywithatleast32chars
FIRST_SUPERUSER=admin@srmtech.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=genai.cjwqmm4a21xa.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=3306
POSTGRES_DB=devops
POSTGRES_USER=demo
POSTGRES_PASSWORD=Devops1234

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
